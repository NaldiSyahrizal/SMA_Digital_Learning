<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#D0D5DD"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvForgotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubah Kata Sandi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#21286A" />

        <TextView
            android:id="@+id/tvForgotSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masukkan alamat email Anda yang terdaftar untuk menerima kode verifikasi OTP."
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- LANGKAH 1: REQUEST OTP -->
        <LinearLayout
            android:id="@+id/layoutStepRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/etForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Email Terdaftar"
                android:paddingStart="18dp"
                android:background="@drawable/edit_outline_dark"
                android:textSize="15sp"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btnRequestOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Kirim Kode OTP"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/btn_color" />

        </LinearLayout>

        <!-- LANGKAH 2: VERIFIKASI OTP -->
        <LinearLayout
            android:id="@+id/layoutStepVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etForgotOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Masukkan 6 Digit OTP"
                android:paddingStart="18dp"
                android:background="@drawable/edit_outline_dark"
                android:textSize="15sp"
                android:inputType="number"
                android:maxLength="6" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Verifikasi Kode OTP"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/btn_color" />

        </LinearLayout>

        <!-- LANGKAH 3: RESET PASSWORD -->
        <LinearLayout
            android:id="@+id/layoutStepReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#777777"
                app:boxBackgroundMode="none">

                <EditText
                    android:id="@+id/etForgotNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Password Baru (min 6 karakter)"
                    android:paddingStart="18dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/edit_outline_dark"
                    android:textSize="15sp"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#777777"
                app:boxBackgroundMode="none">

                <EditText
                    android:id="@+id/etForgotConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Konfirmasi Password Baru"
                    android:paddingStart="18dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/edit_outline_dark"
                    android:textSize="15sp"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Ubah Password"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/btn_color" />

        </LinearLayout>

    </LinearLayout>

    <!-- LOADING OVERLAY FOR DIALOG -->
    <FrameLayout
        android:id="@+id/dialogLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_rounded"
            android:padding="32dp">

            <ImageView
                android:id="@+id/ivDialogLoadingSpinner"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/avd_login_loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Memproses..."
                android:textColor="#102B5E"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
