<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFD">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header Section -->
            <View
                android:id="@+id/headerBg"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#102B5E"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Decorative Circles -->
            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="-50dp"
                android:layout_marginEnd="-50dp"
                android:background="@drawable/bg_notification_dot"
                android:backgroundTint="#1AFFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_notification_dot"
                android:backgroundTint="#33FFFFFF"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Tambah Paket"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <!-- Main Content Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Form Paket Belajar Baru"
                        android:textColor="#102B5E"
                        android:textSize="18sp" />

                    <!-- Tingkatan -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTingkatan"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Pilih Tingkatan"
                        app:boxStrokeColor="#102B5E"
                        app:startIconDrawable="@drawable/ic_class"
                        app:startIconTint="#102B5E">
                        <AutoCompleteTextView
                            android:id="@+id/actvTingkatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="#102B5E" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nama Paket -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNamaPaket"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Nama Paket"
                        app:boxStrokeColor="#102B5E"
                        app:startIconDrawable="@drawable/ic_class"
                        app:startIconTint="#102B5E">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNamaPaket"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#102B5E" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Jurusan with Search -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilJurusan"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Cari Jurusan..."
                        app:boxStrokeColor="#102B5E"
                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="#102B5E">
                        <AutoCompleteTextView
                            android:id="@+id/actvJurusan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#102B5E" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Deskripsi -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDeskripsi"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:hint="Deskripsi Paket"
                        app:boxStrokeColor="#102B5E"
                        app:startIconDrawable="@android:drawable/ic_menu_info_details"
                        app:startIconTint="#102B5E">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeskripsi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="5"
                            android:textColor="#102B5E" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSimpan"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="Tambah Paket Sekarang"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#102B5E" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SPACER JITU -->
            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:layout_constraintTop_toBottomOf="@id/mainCard" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- LOADING OVERLAY -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_rounded"
            android:padding="32dp">
            <ImageView
                android:id="@+id/ivLoadingSpinner"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/avd_login_loading" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sedang menambahkan..."
                android:textColor="#102B5E"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
