<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DigitalLearning" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">#102B5E</item>
        <item name="colorAccent">#102B5E</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/CustomTimePickerTheme</item>
    </style>

    <!-- Date Picker Theme -->
    <style name="CustomDatePickerTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">#102B5E</item>
        <item name="colorAccent">#102B5E</item>
    </style>

    <!-- Time Picker Theme -->
    <style name="CustomTimePickerTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">#102B5E</item>
        <item name="colorAccent">#102B5E</item>
    </style>
</resources>